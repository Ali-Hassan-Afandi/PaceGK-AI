# --- Persistent image storage -------------------------------------------------
# Provider: "local" (development / tests only) or "supabase" (production).
STORAGE_PROVIDER=local
# Local storage path (only used when STORAGE_PROVIDER == "local").
STORAGE_LOCAL_PATH=admission_storage
# Supabase Storage (required when STORAGE_PROVIDER == "supabase").
# SUPABASE_URL=https://<project>.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Knowledge base / RAG ---------------------------------------------------
